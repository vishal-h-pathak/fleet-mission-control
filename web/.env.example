# Fleet Dashboard (web) — environment template. Copy to web/.env.local and fill secrets.
# NEVER commit real values. .env.local is gitignored.

# ── Public (browser-safe; read-only by RLS) ──────────────────────────────────
# Used by the public monitoring plane. The ONLY two vars the client ever sees.
NEXT_PUBLIC_SUPABASE_URL=https://sbmsxerwgylpfkkkjtku.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1W58MgbKCohROwt4WgUvgw_3o6mkeB0

# ── Server-only (NEVER expose to the client / never prefix with NEXT_PUBLIC_) ─
# service_role key — used solely by GET /api/job/[id]/links to read fleet_job_links.
# Get from Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Shared dashboard password exchanged for a signed, httpOnly auth cookie.
FLEET_DASH_PASSWORD=

# HMAC secret used to sign/verify the auth cookie. Use a long random hex string.
FLEET_AUTH_SECRET=
