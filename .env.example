# Fleet Mission Control — environment template. Copy to .env.local (web) / .env (reporter).
# NEVER commit real values. The service-role key and machine tokens are secrets.

# ── Supabase (shared portfolio project) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://sbmsxerwgylpfkkkjtku.supabase.co
# Publishable (anon) key — safe in the browser; read-only by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1W58MgbKCohROwt4WgUvgw_3o6mkeB0

# Service role — SERVER ONLY (authed API routes that read fleet_job_links / rc_url).
# Get from Supabase dashboard → Project Settings → API. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Reporter agent (per machine) ─────────────────────────────────────────────
# Plaintext token from: select public.fleet_register_machine('<name>', '<kind>');
FLEET_TOKEN=
FLEET_INGEST_URL=https://sbmsxerwgylpfkkkjtku.supabase.co/functions/v1/ingest
FLEET_HEARTBEAT_INTERVAL_S=10
# Where this machine's cockpit job logs live (for job-state scraping).
FLEET_COCKPIT_LOG_DIR=~/cockpit-logs
# Optional: override hostname for logging.
FLEET_MACHINE_NAME=

# ── Completion hook (per machine, Phase D / F2-a) ────────────────────────────
# The Claude Code SessionEnd+Notification hook (deploy/hooks/fleet-notify.sh).
# Real values live ONLY in the machine-level, gitignored ~/.config/fleet/hook.env
# (written by deploy/hooks/install-fleet-hook.sh) — placeholders here, never the
# real topic/token. The hook REUSES this machine's FLEET_TOKEN + FLEET_INGEST_URL
# above (no new secret); it adds an ntfy-over-Tailscale push channel:
NTFY_BASE_URL=http://100.86.154.46:8080
# SECRET capability — anyone with the topic can read session output. Placeholder only.
NTFY_TOPIC=fleet-REPLACE_WITH_REAL_TOPIC

# ── Control agent (per machine, P2-A) ────────────────────────────────────────
# Authed against the token-authed commands function with the SAME per-machine FLEET_TOKEN
# above (NO service-role key on the machine). Runs ONLY hard-coded allowlisted verbs.
FLEET_COMMANDS_URL=https://sbmsxerwgylpfkkkjtku.supabase.co/functions/v1/commands
# Poll interval for claiming pending commands (seconds).
FLEET_POLL_INTERVAL_S=4
# Path to the executor script (Mac cockpit). Verbs map to cockpit.sh primitives.
COCKPIT_SH=~/dev/jarvis/portfolio/cockpit.sh
# cockpit.sh needs this to reach the box over Tailscale/SSH (data-pull verbs).
WIN_HOST=
# Optional: max seconds a single verb may run, and max captured-output length.
FLEET_EXEC_TIMEOUT_S=600
FLEET_RESULT_MAXLEN=16000
