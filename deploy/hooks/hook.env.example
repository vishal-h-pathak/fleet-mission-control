# Fleet completion hook — MACHINE-LEVEL config. Template only.
# The installer (install-fleet-hook.sh) writes the real file to
#   ~/.config/fleet/hook.env   (chmod 600, OUTSIDE the repo, never committed).
# fleet-notify.sh sources it. Every value here can also be overridden by a real
# environment variable of the same name.
#
# NEVER commit the real topic or token — they are capabilities/secrets.

# ── ntfy-over-Tailscale (the human push) ──────────────────────────────────────
# Self-hosted ntfy on `sentry`, reachable over Tailscale. Already provisioned.
NTFY_BASE_URL=http://100.86.154.46:8080
# SECRET — anyone holding the topic can read session output. Placeholder only here.
NTFY_TOPIC=fleet-REPLACE_WITH_REAL_TOPIC

# ── Fleet bus (the completion record) ─────────────────────────────────────────
# REUSE this machine's existing reporter token — do NOT mint a new secret.
# Mac: FLEET_TOKEN_MAC_COCKPIT from .fleet-secrets.env;  sentry: FLEET_TOKEN_SENTRY.
FLEET_TOKEN=REPLACE_WITH_THIS_MACHINES_REPORTER_TOKEN
FLEET_INGEST_URL=https://sbmsxerwgylpfkkkjtku.supabase.co/functions/v1/ingest

# ── Optional ──────────────────────────────────────────────────────────────────
# Where Phase-B /rc sidecars live ($LOG_DIR/<tmux-name>.rc). Default ~/cockpit-logs.
FLEET_COCKPIT_LOG_DIR=~/cockpit-logs
# Override the machine name used in logs (defaults to hostname).
# FLEET_MACHINE_NAME=mac-cockpit
# Local hook log (default ~/.fleet/hook.log) and curl timeout (default 8s).
# FLEET_HOOK_LOG=~/.fleet/hook.log
# FLEET_HOOK_CURL_MAX_TIME=8
