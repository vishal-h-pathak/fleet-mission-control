[Unit]
Description=Fleet Mission Control — Reporter agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/dev/jarvis/fleet-mission-control
ExecStart=/home/jarvis/.nvm/versions/node/v24.17.0/bin/node /home/jarvis/dev/jarvis/fleet-mission-control/index.mjs
EnvironmentFile=/home/jarvis/dev/jarvis/fleet-mission-control/.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleet-reporter

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/

[Install]
WantedBy=multi-user.target
