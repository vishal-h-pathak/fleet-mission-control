<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleet.reporter</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Adjust path to your node binary if needed -->
    <string>/usr/local/bin/node</string>
    <string>/Users/jarvis/dev/jarvis/fleet-mission-control/index.mjs</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Load from a dotenv file instead, or set here (secrets!) -->
    <key>FLEET_TOKEN</key>
    <string>REPLACE_ME</string>
    <key>FLEET_INGEST_URL</key>
    <string>https://sbmsxerwgylpfkkkjtku.supabase.co/functions/v1/ingest</string>
    <key>FLEET_HEARTBEAT_INTERVAL_S</key>
    <string>10</string>
    <key>FLEET_COCKPIT_LOG_DIR</key>
    <string>/Users/jarvis/cockpit-logs</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/fleet-reporter.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/fleet-reporter.stderr.log</string>
</dict>
</plist>
