<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fleet.reporter</string>

  <!-- Absolute node path (homebrew). Verify with `command -v node`. -->
  <!-- All config/secrets come from the gitignored .env via --env-file; none are stored here. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>--env-file=.env</string>
    <string>index.mjs</string>
  </array>

  <!-- --env-file=.env and index.mjs resolve relative to this dir. -->
  <key>WorkingDirectory</key>
  <string>/Users/jarvis/dev/jarvis/fleet-mission-control</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/fleet-reporter.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/fleet-reporter.stderr.log</string>
</dict>
</plist>
