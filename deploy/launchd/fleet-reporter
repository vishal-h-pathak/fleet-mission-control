#!/usr/bin/env bash
# fleet-reporter — named launchd entry point so the background item reads "fleet-reporter"
# instead of "node". Thin wrapper: execs the reporter with the same args. Relies on the
# plist's WorkingDirectory (fleet repo root) so --env-file=.env and index.mjs resolve.
exec /opt/homebrew/bin/node --env-file=.env index.mjs "$@"
