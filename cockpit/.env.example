# MCv2 Cockpit — environment template. Copy to .env.local for local dev.
# NEVER commit real values. The service-role key is a secret.

# ── Supabase (same project as web/, work-centric schema v2) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Publishable/anon key — safe in the browser; used ONLY for the signInWithOtp
# auth flow (lib/supabase/client.ts) and to read/refresh the caller's own
# session (lib/supabase/server.ts, middleware.ts). Read-only by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — SERVER ONLY. Bypasses RLS. Used by Server Components / Route
# Handlers (lib/supabase/admin.ts) that read fleet_projects/waves/sessions/
# decisions and write decisions. NEVER prefix with NEXT_PUBLIC_, never import
# admin.ts from a "use client" module. Get it from the Supabase dashboard →
# Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# ── Compose (M4 — read-only committed-prompts source) ────────────────────────
# Fine-grained GitHub PAT, contents:read ONLY, scoped to the fixed fleet repo
# set. Server-only — lib/github/prompts.ts lists/fetches ops/prompts/PROMPT_*.md
# from each project's repo at its default branch HEAD. NEVER prefix with
# NEXT_PUBLIC_. If unset, /compose renders a "read-only: GitHub token not
# configured" state instead of the prompt picker; nothing else in the cockpit
# is affected.
COCKPIT_GITHUB_TOKEN=

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated list of email addresses allowed past middleware.ts, e.g.
# "vshlpthk1@gmail.com". Trimmed and compared case-insensitively. Anyone who
# completes the magic-link flow with an email NOT on this list is signed back
# out and bounced to /login?denied=1.
COCKPIT_ALLOWED_EMAILS=
